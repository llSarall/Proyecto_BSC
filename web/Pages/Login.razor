@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | BSC</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="text-center mb-1">BSC</h3>
                <p class="text-center text-muted mb-4">Inicia sesión para continuar</p>

                <EditForm Model="modelo" OnValidSubmit="IniciarSesion">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <InputText class="form-control" @bind-Value="modelo.Usuario" />
                        <ValidationMessage For="() => modelo.Usuario" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <InputText type="password" class="form-control" @bind-Value="modelo.Password" />
                        <ValidationMessage For="() => modelo.Password" />
                    </div>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger py-2">@error</div>
                    }

                    <button type="submit" class="btn btn-primary w-100" disabled="@cargando">
                        @(cargando ? "Ingresando..." : "Iniciar sesión")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginRequest modelo = new();
    private string? error;
    private bool cargando;

    private async Task IniciarSesion()
    {
        cargando = true;
        error = null;

        try
        {
            error = await AuthService.IniciarSesionAsync(modelo);

            if (error is null)
                Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Verifica que la API esté en ejecución.";
        }
        finally
        {
            cargando = false;
        }
    }
}