@page "/productos/existencias"
@attribute [Authorize(Roles = "Personal Administrativo")]
@inject HttpClient Http

<PageTitle>Existencias | BSC</PageTitle>
<h2 class="mb-4">Reporte de existencias</h2>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (productos is null)
{
    <p>Cargando...</p>
}
else if (productos.Count == 0)
{
    <p class="text-muted">No hay productos registrados.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Clave</th>
                <th>Producto</th>
                <th class="text-end">Existencia</th>
                <th>Estatus</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in productos)
            {
                <tr>
                    <td>@p.ClaveProducto</td>
                    <td>@p.NombreProducto</td>
                    <td class="text-end">@p.Existencia</td>
                    <td>
                        <span class="badge @(p.Existencia == 0 ? "bg-danger" : "bg-success")">
                            @p.EstatusExistencia
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ReporteExistencia>? productos;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<ReporteExistencia>>("api/productos/existencias");
        }
        catch (HttpRequestException)
        {
            error = "No se pudo cargar el reporte de existencias.";
        }
    }
}